rules_version = '2';

// ============================================================
//  代購登記單 Firestore 安全規則
//  ⚠️ 把下面 OWNER_EMAIL 換成你的 Google 帳號（跟 js/config.js 一樣）
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'hailey214h@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function signedIn() { return request.auth != null; }
    function proj(pid) { return get(/databases/$(database)/documents/projects/$(pid)).data; }
    // 客人看得到內容：公開、而且不是鎖定
    function guestCanSee(pid) {
      let p = proj(pid);
      return p.hidden == false && p.status != 'locked';
    }
    function guestCanRegister(pid) {
      let p = proj(pid);
      return p.hidden == false && p.status == 'open';
    }
    function validOrder(d) {
      return d.buyerName is string && d.buyerName.size() > 0 && d.buyerName.size() <= 40
        && d.items is list && d.items.size() > 0 && d.items.size() <= 50
        && d.updatedAt is number
        && !('review' in d);
    }

    match /projects/{pid} {
      // 清單本體：公開的大家看得到（鎖定的也看得到卡片，但點不進去）
      allow read: if isOwner() || (signedIn() && resource.data.hidden == false);
      allow write: if isOwner();

      match /products/{id} {
        allow read: if isOwner() || (signedIn() && guestCanSee(pid));
        allow write: if isOwner();
      }

      match /orders/{oid} {
        allow read: if isOwner() || (signedIn() && guestCanSee(pid));

        // 客人新增登記：只能用自己的身分、不能自己填審核結果
        allow create: if isOwner() || (signedIn()
          && guestCanRegister(pid)
          && request.resource.data.uid == request.auth.uid
          && validOrder(request.resource.data));

        // 客人修改自己的登記：還沒被審核前才可以，只能改項目、時間
        // 賣家可以改任何東西（審核）
        allow update: if isOwner() || (signedIn()
          && guestCanRegister(pid)
          && resource.data.uid == request.auth.uid
          && !('review' in resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['buyerName', 'items', 'updatedAt'])
          && validOrder(request.resource.data));

        allow delete: if isOwner() || (signedIn()
          && guestCanRegister(pid)
          && resource.data.uid == request.auth.uid
          && !('review' in resource.data));
      }
    }
  }
}
